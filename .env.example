# 复制为 .env 后仅在本地填写。不要提交真实 API Key。
# 进程环境变量优先于本文件；CLI 参数优先于两者。

# OpenAI-compatible Provider；以下为 DeepSeek 示例：
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com
MINICLAW_LLM_PROVIDER=openai
MINICLAW_MODEL=deepseek-flash

# 也支持 DEEPSEEK_API_KEY / DEEPSEEK_BASE_URL / DEEPSEEK_MODEL。
# 运行时权限配置
MINICLAW_ALLOW_SEARCH=false
